PORT=3001

# Copy this file to ".env" (same folder) and fill in your values.
# Supabase → Project Settings → API Keys.
# The SECRET key can do anything in your database: keep it only here and in
# Vercel's environment variables. Never put it in the frontend or share it.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# For "Import from PDF" in the Question bank (console.anthropic.com → API keys). Keep secret.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
